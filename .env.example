# Copy to .env (or set these on your host)

# Password for the portal at /admin. Without it, editing only works from
# the computer running the server (http://localhost:3000/admin).
ADMIN_PASSWORD=priyansh159

# Port the server listens on (most hosts set this for you)
PORT=3000

# Folder where the content (invite.json) and the lock, guest password and share links (access.json) are saved.
# On a host, point this at a persistent disk/volume so edits survive restarts.
DATA_DIR=./data
