# Copy to .env for your computer, or add these in Vercel → Settings → Environment Variables.

# Password for the portal at /admin. Without it, editing only works from
# the computer running the server (http://localhost:3000/admin).
ADMIN_PASSWORD=

# Optional: a brand-new site starts locked with this guest password.
# Once you save privacy settings in the portal, the portal's settings win.
GUEST_PASSWORD=

# Vercel: added automatically when you connect an Upstash for Redis database.
# When set, content is saved in Redis instead of files.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Other hosts / your computer: port and the folder for invite.json + access.json.
# On a host, point DATA_DIR at a persistent disk/volume so edits survive restarts.
PORT=3000
DATA_DIR=./data
